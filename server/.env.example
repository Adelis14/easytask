# ====================================================================
# EasyTask Backend - Variables de Entorno (.env)
# Dominio: Reuniones, Minutas y Compromisos (UI-REQ-01.4)
# ====================================================================

# 1. Configuración del Servidor Express
PORT=5000
NODE_ENV=development
SLA_LIMIT_MS=1200

# 2. Seguridad y Autenticación JWT
JWT_SECRET=easytask_secret_key_reuniones_minutas_compromisos
JWT_EXPIRES_IN=7d

# 3. Conexión a Base de Datos PostgreSQL
# Opción A: Cadena de conexión unificada (ej. Supabase, Neon, Render, RDS)
# DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/easytask_db

# Opción B: Parámetros individuales de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=easytask_db
DB_SSL=false

# 4. Parámetros de Rendimiento del Pool (pg) para SLA < 1.2s
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=1000
